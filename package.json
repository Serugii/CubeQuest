{
    "name": "cubequest",
    "version": "1.0.0",
    "description": "An educational site for assembling various Rubik's cubes",
    "main": "index.js",
    "scripts": {
        "build:prod": "webpack build -c config/webpack.production.config.js",
        "build:dev": "webpack build -c config/webpack.development.config.js",
        "start:dev": "webpack serve -c config/webpack.development.config.js",
        "format:fix": "prettier --write src",
        "lint": "eslint --ignore-path .gitignore --ext .js,.jsx --max-warnings 0 ./src",
        "lint:fix": "eslint --ignore-path .gitignore --fix --ext .js,.jsx --max-warnings 0 ./src",
        "test": "jest",
        "test:open": "cypress open",
        "test:e2e": "cypress run --e2e",
        "test:component": "cypress run --component",
        "prepare": "husky && husky install"
    },
    "keywords": [
        "React",
        "eslint"
    ],
    "author": "Luhanskyi Serhii",
    "license": "ISC",
    "dependencies": {
        "@tanstack/react-query": "^5.59.16",
        "axios": "^1.7.7",
        "cors": "^2.8.5",
        "file-loader": "^6.2.0",
        "firebase": "^11.0.1",
        "prop-types": "^15.8.1",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "react-router-dom": "^6.26.2",
        "styled-components": "6.1.13",
        "url-loader": "^4.1.1"
    },
    "devDependencies": {
        "@babel/core": "^7.25.2",
        "@babel/preset-env": "^7.26.0",
        "@babel/preset-react": "^7.25.9",
        "@cypress/code-coverage": "^3.13.2",
        "@istanbuljs/nyc-config-babel": "^3.0.0",
        "@pmmmwh/react-refresh-webpack-plugin": "^0.5.15",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.0.1",
        "babel-jest": "^29.7.0",
        "babel-loader": "^9.2.1",
        "babel-plugin-istanbul": "^7.0.0",
        "copy-webpack-plugin": "^12.0.2",
        "css-loader": "^7.1.2",
        "cypress": "^13.15.1",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^9.1.0",
        "eslint-import-resolver-webpack": "^0.13.9",
        "eslint-plugin-cypress": "^3.6.0",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-react": "^7.37.2",
        "eslint-plugin-react-hooks": "^4.6.2",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "eslint-plugin-unicorn": "^55.0.0",
        "html-webpack-plugin": "^5.6.0",
        "husky": "^8.0.3",
        "identity-obj-proxy": "^3.0.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "lint-staged": "^15.2.10",
        "mini-css-extract-plugin": "^2.9.1",
        "prettier": "^3.3.3",
        "storybook": "8.3.0",
        "style-loader": "^4.0.0",
        "webpack": "^5.94.0",
        "webpack-cli": "^5.1.4",
        "webpack-dev-server": "5.1.0",
        "webpack-merge": "^6.0.1"
    }
}
